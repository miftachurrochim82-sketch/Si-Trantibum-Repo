        signerName: f.signerName, signerPosition: sig.position || "", signerNip: sig.nip || "", signerRank: sig.pangkatGol || (signerUser && signerUser.pangkatGol) || "",
        assetsUsed: f.assetsUsed, status: status, createdBy: (existing && existing.createdBy) || (currentUser.value && currentUser.value.name) || "",
      }, actor.value);
      
      if (mode === "direct-issue") payload.approvalNote = "Diterbitkan langsung oleh Pimpinan.";
      
      const ok = editingLetterId.value
        ? await api("apiUpdateLetter", editingLetterId.value, Object.assign({}, payload, { auditDetail: "ST direvisi (" + status + ")." }))
        : await api("apiCreateLetter", payload);
        
      if (ok) { 
        letterForm.value = null; 
        tab.value = "letters"; 
        // FE-PATCH A1: tampilkan nomor dari respons server bila ada
