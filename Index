    async function submitLetter(mode) {
      const f = letterForm.value; if (!f) return;
      if (!f.title.trim() || !f.startDate) return showFlash("Baris 3 (Nama Kegiatan) dan Baris 4 (Tanggal Mulai) wajib diisi.", "error");
      if (f.endDate && f.endDate < f.startDate) return showFlash("Tanggal Selesai tidak boleh sebelum Tanggal Mulai.", "error");
      if (f.startDate === f.endDate && f.startTime && f.endTime && f.endTime <= f.startTime) return showFlash("Waktu Selesai harus setelah Waktu Mulai.", "error");
      
      if (mode !== "draft") {
        if (!f.legalBasis.trim()) return showFlash("Dasar Surat wajib diisi.", "error");
        if (!f.letterDate) return showFlash("Tanggal Surat wajib diisi.", "error");
        if (!f.village.trim()) return showFlash("Pilih Desa/Kelurahan.", "error");
        if (!f.locationName.trim()) return showFlash("Nama Lokasi spesifik wajib diisi.", "error");
      }
      if (mode === "direct-issue" && role.value !== "PIMPINAN") return showFlash("Penerbitan langsung hanya Pimpinan.", "error");
      
      const personnel = f.personnel.filter(p => p.name.trim());
      if (!personnel.length) return showFlash("Pilih minimal 1 petugas.", "error");
      if (!personnel.some(p => p.role === "Ketua Tim")) personnel[0].role = "Ketua Tim";
      
      const act = actOfForm.value || {};
      const sig = data.value.signers.find(s => s.name === f.signerName) || {};
      const signerUser = data.value.users.find(u => u.name === f.signerName);
      const existing = editingLetterId.value ? data.value.letters.find(l => l.id === editingLetterId.value) : null;
      const status = mode === "draft" ? "DRAFT" : mode === "direct-issue" ? "ISSUED" : "PENDING_APPROVAL";
      
      // FE-PATCH A1: officialNumber TIDAK dikirim dari FE.
      // Server (BE B2) adalah satu-satunya otoritas nomor resmi.
      
      const payload = Object.assign({
        activityCode: f.activityCode, activityName: act.name || "", classification: act.classification || "INTERNAL",
        title: f.title.trim(), letterDate: f.letterDate, startDate: f.startDate, startTime: f.startTime, endDate: f.endDate || f.startDate, endTime: f.endTime, 
        location: f.location, village: f.village.trim(), locationName: f.locationName.trim(), notes: f.notes,
