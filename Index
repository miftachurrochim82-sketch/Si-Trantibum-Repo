    async function handleFileUpload(event) {
      const files = event.target.files;
      if (!files || !files.length) return;
      isUploading.value = true;
      try {
        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          if (file.size > 3 * 1024 * 1024) {
            showFlash(`File ${file.name} terlalu besar (maks 3MB).`, "error");
            continue;
          }
          let base64;
          try {
            base64 = await new Promise((resolve, reject) => {
              const reader = new FileReader();
              reader.onload = (e) => resolve(e.target.result);
              reader.onerror = () => reject(new Error("Gagal membaca file " + file.name));
              reader.readAsDataURL(file);
            });
          } catch (readErr) {
            showFlash(readErr.message, "error");
            continue;
          }
          try {
            const res = await runGas("apiUploadFile", base64, file.name, file.type);
            if (res && res.success) {
              reportForm.value.evidenceList.push(res.url);
            } else {
              showFlash("Gagal upload: " + (res ? res.error : "Unknown error"), "error");
            }
          } catch (err) {
            showFlash("Error upload: " + err.message, "error");
          }
        }
      } finally {
        isUploading.value = false;
        event.target.value = "";
      }
    }

